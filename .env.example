# Copy to .env and fill in. Never commit .env.

PORT=3000
HOST=127.0.0.1
DATA_FILE=data.json

# National Rail Historical Service Performance (HSP).
# Rail Data Marketplace (raildata.org.uk): set the HSP base URL from your subscription page and your API key.
# HSP_BASE_URL=
# HSP_API_KEY=
# Or the older National Rail Data Portal (opendata.nationalrail.co.uk), HSP box ticked:
HSP_BASE_URL=https://hsp-prod.rockshore.net/api/v1
HSP_USERNAME=
HSP_PASSWORD=

# Optional: Gmail (read-only) to pick up booking emails automatically.
# Google Cloud Console → APIs & Services → enable Gmail API → OAuth client (Web application).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback
